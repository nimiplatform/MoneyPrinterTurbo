# Auto detect text files and normalize line endings in the repository
* text=auto
LICENSE -text

# Package-managed text must retain canonical LF bytes on Windows checkouts.
.github/workflows/nimi-app-release.yml text eol=lf
.github/workflows/nimi-web-release.yml text eol=lf
AGENTS.md text eol=lf
.agents/skills/nimi-app-lifecycle/** text eol=lf
.nimi/**/*.yaml text eol=lf
NIMI_APP.md text eol=lf
NIMI_APP.*.md text eol=lf
RELEASE_NOTES.md text eol=lf

# Binary assets
*.mp3 binary
*.mp4 binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.ttc binary
*.otf binary
*.woff binary
*.woff2 binary
